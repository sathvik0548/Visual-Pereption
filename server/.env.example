# Copy this file to .env and fill in your keys
# GEMINI_API_KEY is required (free at aistudio.google.com) — used for vision analysis
GEMINI_API_KEY=your_gemini_api_key_here

# GROQ_API_KEY — used for cloud VLM mode
GROQ_API_KEY=your_groq_api_key_here

# Provider mode configuration: "cloud" (Groq) or "offline" (Local Ollama)
VLM_MODE=cloud

# Local Ollama Settings (for fully offline mode)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=moondream
