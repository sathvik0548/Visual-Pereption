# Copy this file to .env and fill in your keys
# GEMINI_API_KEY is required (free at aistudio.google.com) — used for vision analysis
GEMINI_API_KEY=your_gemini_api_key_here

# GROQ_API_KEY — kept here for reference (Groq removed vision support, used for text-only mode)
GROQ_API_KEY=your_groq_api_key_here
